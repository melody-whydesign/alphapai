<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Particle Morph</title>

<link rel="stylesheet" href="style.css">

<script
src="https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest"
type="module">
</script>

</head>

<body>

<div class="bg"></div>

<header>

<h1>
Particle Morph
</h1>

<p>
Transform images into generative dot–dash renderings
</p>

</header>

<div class="panel">

<label class="upload">

<input id="upload" type="file" accept="image/*">

<span>Upload Image</span>

</label>

<button id="generate">
Generate
</button>

<button id="download">
Download
</button>

</div>

<div class="canvas-wrap">

<canvas id="canvas"></canvas>

</div>

<script type="module" src="app.js"></script>

</body>
</html>
