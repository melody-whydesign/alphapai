<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Particle Morph Studio</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:
Inter,
system-ui,
sans-serif;
}

body{
background:
linear-gradient(
180deg,
#ffffff,
#f5f7fa
);

color:#111;

min-height:100vh;

display:flex;
justify-content:center;
padding:60px;
}

.container{
width:min(1200px,100%);
}

.hero{
text-align:center;
margin-bottom:50px;
}

h1{
font-size:64px;
font-weight:700;

background:
linear-gradient(
90deg,
#111,
#555
);

-webkit-background-clip:text;
color:transparent;
}

.subtitle{
margin-top:14px;
color:#666;
font-size:18px;
}

.panel{

background:
rgba(255,255,255,.72);

backdrop-filter:
blur(30px);

border:
1px solid rgba(0,0,0,.06);

border-radius:30px;

padding:32px;

box-shadow:
0 20px 80px rgba(0,0,0,.08);

}

.controls{
display:flex;
gap:14px;
justify-content:center;
margin-bottom:30px;
flex-wrap:wrap;
}

button,
input{

height:54px;

padding:
0 22px;

border-radius:
999px;

border:none;

font-size:16px;

}

button{

background:
linear-gradient(
90deg,
#111,
#444
);

color:white;

cursor:pointer;

transition:.25s;

}

button:hover{

transform:
translateY(-2px);

}

input{
background:#f3f5f7;
}

canvas{

width:100%;

background:white;

border-radius:20px;

}

.footer{
margin-top:20px;
text-align:center;
color:#777;
font-size:13px;
}

</style>
</head>

<body>

<div class="container">

<div class="hero">

<h1>Hybrid Dot–Dash</h1>

<div class="subtitle">

Upload → Generate → Export

</div>

</div>

<div class="panel">

<div class="controls">

<input
type="file"
id="upload"
accept="image/*">

<button id="generate">

Generate

</button>

<button id="download">

Export PNG

</button>

</div>

<canvas id="canvas"></canvas>

</div>

<div class="footer">

Generative particle abstraction

</div>

</div>

<script>

const canvas=
document.getElementById("canvas");

const ctx=
canvas.getContext("2d");

canvas.width=1400;
canvas.height=1400;

ctx.fillStyle="white";
ctx.fillRect(
0,
0,
canvas.width,
canvas.height
);

let image=null;

upload.onchange=e=>{

const file=
e.target.files[0];

if(!file)return;

const reader=
new FileReader();

reader.onload=()=>{

image=
new Image();

image.onload=()=>{

ctx.fillStyle=
"white";

ctx.fillRect(
0,
0,
canvas.width,
canvas.height
);

drawPreview();

};

image.src=
reader.result;

};

reader.readAsDataURL(file);

};

function drawPreview(){

const s=
fit(
image.width,
image.height
);

ctx.drawImage(
image,
s.x,
s.y,
s.w,
s.h
);

}

function fit(w,h){

let scale=
Math.min(
1200/w,
1200/h
);

return{

w:w*scale,

h:h*scale,

x:
(1400-w*scale)/2,

y:
(1400-h*scale)/2

};

}

generate.onclick=()=>{

if(!image)return;

render();

};

function render(){

ctx.fillStyle=
"white";

ctx.fillRect(
0,
0,
1400,
1400
);

let off=
document.createElement(
"canvas"
);

let o=
off.getContext(
"2d"
);

off.width=
1400;

off.height=
1400;

let s=
fit(
image.width,
image.height
);

o.drawImage(
image,
s.x,
s.y,
s.w,
s.h
);

let img=
o.getImageData(
0,
0,
1400,
1400
);

let d=
img.data;

for(
let y=0;
y<1400;
y+=3
){

for(
let x=0;
x<1400;
x+=3
){

let i=
(
y*1400+x
)*4;

let r=d[i];
let g=d[i+1];
let b=d[i+2];

let brightness=
(
r+g+b
)/3;

if(
brightness>
245
)
continue;

let density=
(
255-brightness
)/255;

if(
Math.random()
>
density
)
continue;

ctx.fillStyle=
`rgb(${r},${g},${b})`;

let p=
Math.random();

let size=
1+
density*
12;

if(
p<0.45
){

ctx.beginPath();

ctx.arc(
x+
rand(2),
y+
rand(2),
size*.5,
0,
7
);

ctx.fill();

}

else{

let len=
size*
(
1+
Math.random()*4
);

let h=
size*
(
0.3+
Math.random()
);

roundRect(
ctx,
x,
y,
len,
h,
h/2
);

ctx.fill();

}

}

}

}

function roundRect(
c,
x,
y,
w,
h,
r
){

c.beginPath();

c.moveTo(
x+r,
y
);

c.lineTo(
x+w-r,
y
);

c.quadraticCurveTo(
x+w,
y,
x+w,
y+r
);

c.lineTo(
x+w,
y+h-r
);

c.quadraticCurveTo(
x+w,
y+h,
x+w-r,
y+h
);

c.lineTo(
x+r,
y+h
);

c.quadraticCurveTo(
x,
y+h,
x,
y+h-r
);

c.lineTo(
x,
y+r
);

c.quadraticCurveTo(
x,
y,
x+r,
y
);

c.closePath();

}

function rand(v){

return(
Math.random()-.5
)*v;

}

download.onclick=()=>{

let a=
document.createElement(
"a"
);

a.href=
canvas.toDataURL(
"image/png"
);

a.download=
"hybrid-dot-dash.png";

a.click();

};

</script>

</body>

</html>
